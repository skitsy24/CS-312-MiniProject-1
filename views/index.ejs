<!DOCTYPE html>
<html>
<head>
  <title>My Blog</title>
</head>
<body>

  <h1>My Blog</h1>
  <p>Welcome to my blog.</p>
    <% posts.forEach(post => { %>

    <h2><%= post.title %></h2>
    <p>By <%= post.author %></p>
    <p><%= post.content %></p>
    <p><%= post.createdAt %></p>

    <% }); %>
</body>
</html>