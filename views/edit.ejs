<form action="/posts/<%= post.id %>/edit" method="POST">

  <label for="author">Author</label>
  <input
    type="text"
    id="author"
    name="author"
    value="<%= post.author %>"
  >

  <label for="title">Title</label>
  <input
    type="text"
    id="title"
    name="title"
    value="<%= post.title %>"
  >

  <label for="content">Content</label>
  <textarea
    id="content"
    name="content"
  ><%= post.content %></textarea>

  <button type="submit">Save Changes</button>

</form>